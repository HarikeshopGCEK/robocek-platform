{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ROBOCEK Studio",
  "version": "0.2.0",
  "identifier": "org.robocek.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ROBOCEK Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "ROBOCEK GCEK",
    "copyright": "Copyright © ROBOCEK GCEK. All rights reserved.",
    "shortDescription": "ROBOCEK IDE by ROBOCEK GCEK",
    "longDescription": "ROBOCEK IDE - Advanced Robotics & Firmware Development Environment. Published and copyrighted by ROBOCEK GCEK.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../robocek-cli": "platform/robocek-cli"
    }
  }
}